---
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	id?: string;
	icon?: string;
	media?: boolean;
}

const { title, id, icon = 'video', media = false } = Astro.props;
---

<div class="mx-auto flex w-full max-w-lg flex-col gap-3" id={id}>
	<!-- Section Header -->
	<div class="flex items-center justify-between px-2">
		<div class="flex min-w-0 items-center gap-2">
			<Icon
				name={icon}
				class="text-primary h-[18px] w-[18px] shrink-0"
			/>
			<h2
				class="text-primary truncate text-[11px] font-bold tracking-wider uppercase"
			>
				{title}
			</h2>
		</div>

		<div class="flex shrink-0 items-center gap-2">
			<slot name="action" />
		</div>
	</div>

	{
		media ? (
			<div class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2">
				<slot />
			</div>
		) : (
			<div class="flex flex-col gap-3">
				<slot />
			</div>
		)
	}
</div>