---
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	thumbnail: string;
	href?: string;
	isShorts?: boolean;
	class?: string;
}

const {
	title,
	thumbnail,
	href = '#',
	isShorts,
	class: className
} = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={[
		'group border-outline-variant relative block h-32 w-full overflow-hidden rounded-3xl border shadow-md transition-all duration-300 hover:shadow-xl',
		className
	]}
>
	<img
		src={thumbnail}
		alt={title}
		class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
		onerror="this.onerror=null;this.src='https://placehold.co/600x400/2f0e13/e88d92?text=No+Thumb'"
	/>

	<!-- Dark scrim: kept dark in both themes for media legibility -->
	<div
		class="absolute inset-0 bg-gradient-to-t from-[#140c0d]/95 via-[#140c0d]/60 to-[#140c0d]/30 transition-colors duration-300 group-hover:from-[#140c0d]/90"
	></div>

	<div class="relative z-10 flex h-full w-full flex-col justify-between gap-2 p-3 text-white">
		<div class="flex items-center justify-between">
			<span
				class="bg-primary-container/90 text-on-primary-container border-primary/30 inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-[11px] font-bold tracking-wider uppercase shadow-sm backdrop-blur-md"
			>
				<Icon name={isShorts ? 'yt_shorts' : 'youtube'} class="h-3 w-3" />
				{isShorts ? 'Shorts' : 'YouTube'}
			</span>
		</div>

		<div class="flex items-center gap-2">
			<p title={title} class="min-w-0 flex-1 truncate text-sm leading-tight font-bold drop-shadow-sm">
				{title}
			</p>
		</div>
	</div>
</a>