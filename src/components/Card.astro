---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	subtitle?: string;
	icon?: string;
	image?: ImageMetadata | string;
	href?: string;
	featured?: boolean;
}

const { title, subtitle, icon = 'link', image, href = '#', featured = false } = Astro.props;

// "External" = leaves the current site's exact host. Internal relative links
// (`/…`, `#…`) and same-host absolute URLs keep the arrow; everything else
// (other domains, and other futami.my.id subdomains) gets an open-in-new icon.
function isExternalHref(value: string): boolean {
	if (value.startsWith('/') || value.startsWith('#')) return false;
	try {
		const url = new URL(value);
		return url.host !== Astro.url.host;
	} catch {
		return false;
	}
}

const isExternal = isExternalHref(href);
const trailingIcon = isExternal ? 'open-in-new' : 'arrow-right';
---

<a
	href={href}
	target={isExternal ? '_blank' : undefined}
	rel={isExternal ? 'noopener noreferrer' : undefined}
	class:list={[
		'group flex items-center justify-between rounded-full p-3 pl-4 pr-4 shadow-sm transition-all duration-200 hover:shadow-md active:scale-95',
		featured
			? 'border-primary-container bg-primary-container text-on-primary-container hover:brightness-110'
			: 'border-outline-variant bg-surface-container-low text-on-surface hover:bg-surface-container-high'
	]}
>
	<div class="flex min-w-0 items-center gap-3">
		<div
			class:list={[
				'flex w-10 h-10 shrink-0 items-center justify-center overflow-hidden transition-transform duration-200 group-hover:scale-105',
				image
					? 'border-outline-variant rounded-full border bg-surface shadow-sm'
					: featured
						? 'bg-on-primary-container text-primary-container rounded-full'
						: 'bg-surface-variant text-primary rounded-full'
			]}
		>
			{
				image ? (
					typeof image === 'string' ? (
						<img src={image} alt={title} class="h-full w-full object-cover" />
					) : (
						<Image src={image} alt={title} class="h-full w-full object-cover" />
					)
				) : (
					<Icon name={icon} class="h-5 w-5" />
				)
			}
		</div>

		<div class="flex min-w-0 flex-col text-left">
			<span class="truncate text-base leading-tight font-bold">{title}</span>
			{
				subtitle && (
					<span
						class:list={[
							'mt-0.5 truncate text-[11px] leading-tight font-medium',
							featured
								? 'text-on-primary-container/80'
								: 'text-on-surface-variant'
						]}
					>
						{subtitle}
					</span>
				)
			}
		</div>
	</div>

	<div
		class:list={[
			'ml-2 flex h-9 w-9 shrink-0 items-center justify-center rounded-full transition-colors duration-200',
			featured
				? 'text-on-primary-container group-hover:bg-on-primary-container/10'
				: 'text-on-surface-variant group-hover:text-primary'
		]}
	>
		<Icon name={trailingIcon} class="h-5 w-5 -translate-x-1 opacity-70 transition-transform duration-200 group-hover:translate-x-0 group-hover:opacity-100" />
	</div>
</a>