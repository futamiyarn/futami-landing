---
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	subtitle?: string;
	href?: string;
	thumbnail?: string;
	class?: string;
}

const {
	title,
	subtitle,
	href = '#',
	thumbnail,
	class: className
} = Astro.props;

// Default thumbnail for blog if not provided
const defaultThumbnail =
	'https://placehold.co/600x400/2f0e13/e88d92?text=Futami+Blog';
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={[
		'group border-outline-variant bg-surface-container-low text-on-surface hover:bg-surface-container flex items-center justify-between rounded-full border p-3 pl-4 pr-4 shadow-sm transition-all duration-200 hover:shadow-md',
		className
	]}
>
	<div class="flex min-w-0 items-center gap-3">
		<div
			class="border-outline-variant flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-surface shadow-sm transition-transform duration-200 group-hover:scale-105"
		>
			<img
				src={thumbnail || defaultThumbnail}
				alt={title}
				class="h-full w-full object-cover"
				onerror={`this.onerror=null;this.src='${defaultThumbnail}'`}
			/>
		</div>

		<div class="flex min-w-0 flex-col text-left">
			<span class="truncate text-base leading-tight font-semibold">{title}</span>
			{
				subtitle && (
					<span class="text-on-surface-variant mt-0.5 truncate text-sm leading-tight font-medium">
						{subtitle}
					</span>
				)
			}
		</div>
	</div>

	<div
		class="text-on-surface-variant group-hover:text-primary ml-2 flex h-9 w-9 shrink-0 items-center justify-center rounded-full transition-colors duration-200"
	>
		<Icon
			name="arrow-right"
			class="h-5 w-5 -translate-x-1 opacity-70 transition-transform duration-200 group-hover:translate-x-0 group-hover:opacity-100"
		/>
	</div>
</a>