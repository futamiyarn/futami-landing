---
import { Icon } from 'astro-icon/components';

interface Props {
	href: string;
	icon: string;
	label?: string;
}

const { href, icon, label = 'Link navigasi' } = Astro.props;

// Logika untuk menentukan apakah tombol sedang aktif/dipilih
// Aktif jika href adalah '#' (digunakan di halaman saat ini) atau jika path cocok
const pathname = Astro.url.pathname.replace(/\/$/, '');
const targetHref = href.replace(/\/$/, '');
const isActive = href === '#' || (targetHref !== '' && pathname === targetHref);
---

<a
	href={href}
	aria-label={label}
	class:list={[
		'border flex h-10 w-10 items-center justify-center rounded-full shadow-sm transition-all duration-200 hover:shadow-md active:scale-95',
		{
			// Gaya saat AKTIF (Selected) - Menggunakan warna Primary yang lebih menonjol
			'border-primary bg-primary text-on-primary': isActive,
			// Gaya saat TIDAK AKTIF - Tonal chip seperti referensi
			'border-outline-variant bg-surface-container-low text-on-surface hover:bg-surface-container-high hover:text-primary':
				!isActive
		}
	]}
>
	<Icon name={icon} class="h-5 w-5" />
</a>