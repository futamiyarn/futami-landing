---
import Layout from '@layouts/Layout.astro';
import Section from '@components/Section.astro';
import Card from '@components/Card.astro';
import platformsRaw from '@data/platforms.json';

const platforms = platformsRaw.filter((item) => !item.archive);
const categories = [...new Set(platforms.map((item) => item.kategori))];
---

<Layout title="Channels - Futami">
	{
		categories.map((category) => (
			<Section
				title={category}
				id={category.toLowerCase().replace(/\s+/g, '-')}
				icon={category.includes('Playlist') ? 'playlist' : 'video'}
			>
				{platforms
					.filter((item) => item.kategori === category)
					.map((item, index) => (
						<Card
							title={item.nama}
							subtitle={item.deskripsi}
							icon={item.icon_name}
							href={item.url}
							featured={category === categories[0] && index === 0}
						/>
					))}
			</Section>
		))
	}
</Layout>
